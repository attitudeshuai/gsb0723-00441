<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.mapper.TeacherMapper">

    <resultMap id="TeacherVOResultMap" type="com.school.vo.TeacherVO">
        <id column="id" property="id"/>
        <result column="teacher_no" property="teacherNo"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="subject" property="subject"/>
        <result column="status" property="status"/>
        <result column="is_head_teacher" property="isHeadTeacher"/>
        <result column="head_teacher_class" property="headTeacherClass"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectTeacherPage" resultMap="TeacherVOResultMap">
        SELECT t.id, t.teacher_no, t.name, t.gender, t.phone, t.subject, t.status, t.create_time,
               CASE WHEN c.id IS NOT NULL THEN TRUE ELSE FALSE END as is_head_teacher,
               c.class_name as head_teacher_class
        FROM teacher t
        LEFT JOIN class c ON t.id = c.teacher_id AND c.deleted = 0
        WHERE t.deleted = 0
        <if test="name != null and name != ''">
            AND t.name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="subject != null and subject != ''">
            AND t.subject LIKE CONCAT('%', #{subject}, '%')
        </if>
        ORDER BY t.teacher_no
    </select>

</mapper>
