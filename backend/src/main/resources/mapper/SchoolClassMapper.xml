<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.mapper.SchoolClassMapper">

    <resultMap id="ClassVOResultMap" type="com.school.vo.ClassVO">
        <id column="id" property="id"/>
        <result column="grade" property="grade"/>
        <result column="class_no" property="classNo"/>
        <result column="class_name" property="className"/>
        <result column="teacher_id" property="teacherId"/>
        <result column="teacher_name" property="teacherName"/>
        <result column="student_count" property="studentCount"/>
    </resultMap>

    <select id="selectClassList" resultMap="ClassVOResultMap">
        SELECT c.id, c.grade, c.class_no, c.class_name, c.teacher_id,
               (SELECT COUNT(*) FROM student s WHERE s.class_id = c.id AND s.deleted = 0) as student_count,
               t.name as teacher_name
        FROM class c
        LEFT JOIN teacher t ON c.teacher_id = t.id
        WHERE c.deleted = 0
        <if test="grade != null">
            AND c.grade = #{grade}
        </if>
        ORDER BY c.grade, c.class_no
    </select>

    <select id="selectByTeacherId" resultType="com.school.entity.SchoolClass">
        SELECT * FROM class WHERE teacher_id = #{teacherId} AND deleted = 0 LIMIT 1
    </select>

</mapper>
