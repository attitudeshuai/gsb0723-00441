<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.mapper.NoticeMapper">

    <resultMap id="NoticeResultMap" type="com.school.entity.Notice">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="type" property="type"/>
        <result column="is_top" property="isTop"/>
        <result column="publisher_id" property="publisherId"/>
        <result column="publish_time" property="publishTime"/>
        <result column="status" property="status"/>
        <result column="publisher_name" property="publisherName"/>
    </resultMap>

    <select id="selectNoticePage" resultMap="NoticeResultMap">
        SELECT n.id, n.title, n.content, n.type, n.is_top, n.publisher_id,
               n.publish_time, n.status, u.real_name as publisher_name
        FROM notice n
        LEFT JOIN sys_user u ON n.publisher_id = u.id
        WHERE n.deleted = 0 AND n.status = 1
        <if test="type != null">
            AND n.type = #{type}
        </if>
        ORDER BY n.is_top DESC, n.publish_time DESC
    </select>

</mapper>
